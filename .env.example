[TEMPLATE]
# Copy this file to `.env` and fill in real values. `.env` is never committed.
#
# The app reads every value below through `src/config.ts`. Nothing is hardcoded
# in the source, and the app refuses to start against anything that is not
# testnet.

# Only "testnet" is accepted. Any other value makes the app refuse to operate.
VITE_STELLAR_NETWORK=testnet

# Stellar RPC endpoint. The public testnet endpoint is
# https://soroban-testnet.stellar.org (developers.stellar.org -> RPC providers).
VITE_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# The deployed eventbadges contract id (a C... address). PLACEHOLDER ONLY:
# nothing is deployed yet, so this value will not work. Set it after the human
# runs scripts/deploy-testnet.sh, and never before a real organizer has agreed
# to a pilot.
VITE_CONTRACT_ID=YOUR_DEPLOYED_TESTNET_CONTRACT_ID

# Where transaction links point. The app only ever appends /tx/<hash> and
# /contract/<id>.
VITE_EXPLORER_BASE_URL=https://stellar.expert/explorer/testnet
